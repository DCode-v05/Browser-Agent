{
  "title": "Asking before risky presses on the desktop",
  "lead": "Whether a person is asked before a press that deletes in an app of the desktop, and is not asked for a harmless one.",
  "tasks": [
    {
      "id": "ask-delete-a-draft",
      "title": "Removing a draft with the editor's Delete Selection",
      "task": "In the text editor, write the word draft. Select all of it and remove it with Delete Selection in the editor's Edit menu. Then write the word final and save it as final.txt in the folder Practice inside Files.",
      "start": "desktop",
      "pass": [
        {
          "state": "files.final_txt",
          "has": "final"
        },
        {
          "state": "files.final_txt",
          "lacks": "draft"
        }
      ],
      "solution": [
        [
          "app",
          "Text editor"
        ],
        [
          "page"
        ],
        [
          "type",
          "draft"
        ],
        [
          "key",
          "Control+a"
        ],
        [
          "press",
          "Edit"
        ],
        [
          "press",
          "Delete Selection"
        ],
        [
          "type",
          "final"
        ],
        [
          "key",
          "Control+s"
        ],
        [
          "wait",
          1
        ],
        [
          "submit",
          "~/Files/Practice/final.txt"
        ],
        [
          "wait",
          1
        ]
      ],
      "risky": true
    },
    {
