# Copy this file to .env (same folder) and fill in the key. The .env file is never committed.

# The key of the model the agent loop calls (agent.api_key_env in config.json names this variable).
OPENAI_API_KEY=

# Optional. The token that lets a viewer in. When it is not set, a new one is made at every start.
# BAP_BROWSER_TOKEN=
