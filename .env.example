# Copy this file to .env (same folder) and fill in what you need. The .env file is never committed.
# It is read from the folder the command is run in. What the environment already holds wins.

# The key of the model the agent loop calls (agent.api_key_env in config.json names this variable).
OPENAI_API_KEY=
# The service token. When unset, a token is generated at start.
BAP_BROWSER_TOKEN=
# Path of the configuration file. When unset, ./config.json is used if it exists.
BAP_BROWSER_CONFIG=
# Proxy credentials, used only when browser.proxy.server is set.
BAP_BROWSER_PROXY_USERNAME=
BAP_BROWSER_PROXY_PASSWORD=
